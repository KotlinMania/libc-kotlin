headers = stdlib.h unistd.h string.h stdio.h fcntl.h sys/socket.h sys/types.h sys/stat.h sys/uio.h sys/mman.h sys/time.h sys/wait.h sys/select.h sys/ioctl.h sys/utsname.h signal.h errno.h time.h dirent.h pthread.h netdb.h arpa/inet.h netinet/in.h netinet/tcp.h poll.h syslog.h crypt.h utmpx.h sched.h locale.h wchar.h wctype.h ctype.h math.h semaphore.h sys/ipc.h sys/shm.h sys/msg.h sys/sem.h sys/resource.h sys/param.h sys/un.h sys/epoll.h sys/inotify.h sys/eventfd.h sys/timerfd.h sys/signalfd.h sys/xattr.h sys/sendfile.h sys/statvfs.h sys/swap.h sys/sysinfo.h sys/times.h sys/types.h termios.hgrp.h pwd.h utime.h glob.h getopt.h dlfcn.h linker.h sys/auxv.h sys/random.h sys/timerfd.h endian.h byteswap.h
