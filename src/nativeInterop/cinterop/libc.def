headers = stdlib.h stdio.h string.h libc_wrapper.h
headerFilter = *
compilerOpts = -Isrc/nativeInterop/cinterop
staticLibraries = libc_wrapper.a
noStringConversion = libc_strchr libc_strrchr libc_strstr libc_strpbrk libc_strdup libc_strcpy libc_strncpy libc_strcat libc_strncat libc_strtok libc_getcwd libc_realpath libc_tmpnam libc_mkdtemp libc_strndup libc_strxfrm libc_strtol libc_strtoll libc_strtoul libc_strtoull
