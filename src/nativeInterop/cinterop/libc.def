headers = stdlib.h stdio.h string.h sys/socket.h dirent.h libc_wrapper.h
headerFilter = *
compilerOpts = -Isrc/nativeInterop/cinterop
staticLibraries = libc_wrapper.a
libraryPaths = src/nativeInterop/cinterop
noStringConversion = libc_strchr libc_strrchr libc_strstr libc_strpbrk libc_strcpy libc_strncpy libc_strcat libc_strncat libc_strtok libc_getcwd libc_realpath libc_tmpnam libc_mkdtemp
