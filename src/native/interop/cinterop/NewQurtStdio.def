package = io.github.kotlinmania.libc.new.qurt.stdio.cinterop
headers = new_qurt_stdio_wrapper.h
headerFilter = new_qurt_stdio_wrapper.h
compilerOpts = -Isrc/native/interop/cinterop
staticLibraries = new_qurt_stdio_wrapper.a
noStringConversion = libcNewQurtStdioFopen libcNewQurtStdioFreopen libcNewQurtStdioFputs libcNewQurtStdioPuts libcNewQurtStdioPrintf libcNewQurtStdioFprintf libcNewQurtStdioSprintf libcNewQurtStdioSnprintf libcNewQurtStdioVprintf libcNewQurtStdioVfprintf libcNewQurtStdioVsprintf libcNewQurtStdioVsnprintf libcNewQurtStdioScanf libcNewQurtStdioFscanf libcNewQurtStdioSscanf libcNewQurtStdioPerror libcNewQurtStdioRemove libcNewQurtStdioRename
