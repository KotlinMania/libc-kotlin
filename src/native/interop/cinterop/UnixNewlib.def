package = io.github.kotlinmania.libc.unix.newlib.cinterop
headers = unix_newlib_wrapper.h
headerFilter = unix_newlib_wrapper.h
compilerOpts = -Isrc/native/interop/cinterop
staticLibraries = unix_newlib_wrapper.a
linkerOpts.mingw = -lws2_32
noStringConversion = libcUnixNewlibGetgrnamR libcUnixNewlibSemOpen libcUnixNewlibGetgrnam libcUnixNewlibSemUnlink libcUnixNewlibGetpwnamR libcUnixNewlibPopen
