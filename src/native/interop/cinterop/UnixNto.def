package = io.github.kotlinmania.libc.unix.nto.cinterop
headers = unix_nto_wrapper.h
headerFilter = unix_nto_wrapper.h
compilerOpts = -Isrc/native/interop/cinterop
staticLibraries = unix_nto_wrapper.a
linkerOpts.mingw = -lws2_32
noStringConversion = libcUnixNtoMkfifoat libcUnixNtoMknodat libcUnixNtoUtimensat libcUnixNtoExecvpe libcUnixNtoShmOpen libcUnixNtoFtok libcUnixNtoGlob libcUnixNtoShmUnlink libcUnixNtoSetdomainname libcUnixNtoUmount libcUnixNtoMount libcUnixNtoSethostname libcUnixNtoGetgrnamR libcUnixNtoInitgroups libcUnixNtoSemOpen libcUnixNtoGetgrnam libcUnixNtoSemUnlink libcUnixNtoGetpwnamR libcUnixNtoGetgrouplist libcUnixNtoPosixSpawn libcUnixNtoPosixSpawnp libcUnixNtoPosixSpawnFileActionsAddopen libcUnixNtoPopen libcUnixNtoFaccessat libcUnixNtoInotifyAddWatch libcUnixNtoPthreadSetnameNp libcUnixNtoRegcomp libcUnixNtoRegexec libcUnixNtoMqOpen libcUnixNtoMqSend libcUnixNtoMqTimedsend libcUnixNtoMqUnlink
