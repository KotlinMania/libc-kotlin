package = io.github.kotlinmania.libc.windows.cinterop
headers = windows_wrapper.h
headerFilter = windows_wrapper.h
compilerOpts = -Isrc/native/interop/cinterop
staticLibraries = windows_wrapper.a
linkerOpts.mingw = -lws2_32
noStringConversion = libcWindowsPrintf libcWindowsFprintf libcWindowsFopen libcWindowsFreopen libcWindowsRemove libcWindowsRename libcWindowsFputs libcWindowsPuts libcWindowsPerror libcWindowsAtof libcWindowsAtoi libcWindowsAtol libcWindowsAtoll libcWindowsStrtod libcWindowsStrtof libcWindowsStrtol libcWindowsStrtoll libcWindowsStrtoul libcWindowsStrtoull libcWindowsSystem libcWindowsGetenv libcWindowsStrcpy libcWindowsStrncpy libcWindowsStrcat libcWindowsStrncat libcWindowsStrcmp libcWindowsStrncmp libcWindowsStrcoll libcWindowsStrchr libcWindowsStrrchr libcWindowsStrspn libcWindowsStrcspn libcWindowsStrdup libcWindowsStrpbrk libcWindowsStrstr libcWindowsStrlen libcWindowsStrnlen libcWindowsStrtok libcWindowsStrxfrm libcWindowsChmod libcWindowsMkdir libcWindowsStat libcWindowsPopen libcWindowsFdopen libcWindowsOpen libcWindowsCreat libcWindowsAccess libcWindowsChdir libcWindowsExecl libcWindowsExecle libcWindowsExeclp libcWindowsExeclpe libcWindowsExecv libcWindowsExecve libcWindowsExecvp libcWindowsExecvpe libcWindowsRmdir libcWindowsUnlink libcWindowsSetlocale libcWindowsPutenv libcWindowsPutenvS libcWindowsSendto libcWindowsSetsockopt
